# The version used by the signed Studio release bundles.
basic-memory==1.0.0
# macOS Intel (x86_64): cryptography stopped publishing wheels for it in 49; 48.x still has them.
cryptography<49; sys_platform == "darwin" and platform_machine == "x86_64"
# Same for onnxruntime (a fastembed dependency): its last macOS Intel wheels are 1.23.x.
onnxruntime<=1.23.2; sys_platform == "darwin" and platform_machine == "x86_64"
